<UserControl x:Class="Opti.App.Views.StrategyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Stretch">
            <TextBlock Text="Исправления" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding Header}" Style="{StaticResource Secondary}"/>

            <!-- Режим: можно сменить, план пересоберётся -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="16,12">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="Режим" Style="{StaticResource Strong}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding Goals}" SelectedItem="{Binding SelectedGoal}"
                                 DisplayMemberPath="Title" AutomationProperties.Name="Режим оптимизации"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Fixes}" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,0,6,0" MinWidth="0"/>
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Tag}" Margin="8,0,0,0" Background="{Binding RiskColor, Converter={StaticResource ToneToSoft}}">
                                            <TextBlock Text="{Binding RiskText}" Style="{StaticResource TagText}" Foreground="{Binding RiskColor, Converter={StaticResource ToneToBrush}}"/>
                                        </Border>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Tag}" Margin="8,0,0,0" Background="{StaticResource AccentSoftBrush}"
                                                Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="перезагрузка" Style="{StaticResource TagText}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Strong}"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource Secondary}" Margin="0,2,0,0"/>
                                    <ItemsControl ItemsSource="{Binding Notes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Caption}" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,4,0,0"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Visibility="{Binding ShowStartupChoices, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Что убрать из автозагрузки" Style="{StaticResource Strong}"/>
                    <TextBlock Text="Отключаются только отмеченные — как в «Диспетчере задач». Вернуть можно в любой момент." Style="{StaticResource Caption}" Margin="0,2,0,8"/>
                    <ItemsControl ItemsSource="{Binding StartupChoices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Name}" ToolTip="{Binding Detail}" Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding NeedsBitLockerAck, Converter={StaticResource BoolToVis}}">
                <CheckBox IsChecked="{Binding BitLockerAcknowledged}">
                    <TextBlock TextWrapping="Wrap" Text="На системном диске включён BitLocker. Изменение конфигурации загрузки может запросить ключ восстановления — ключ у меня под рукой."/>
                </CheckBox>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Style="{StaticResource AccentButton}" Content="Применить выбранное" Command="{Binding ApplyCommand}"/>
                <TextBlock Text="Перед изменениями создаётся точка восстановления." Style="{StaticResource Caption}" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Visibility="{Binding AbFixes.Count, Converter={StaticResource CountToVis}}">
                <TextBlock Text="Проверить замером" Style="{StaticResource SectionTitle}"/>
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                           Text="Эффект этих настроек зависит от железа. Opti замерит текущий вариант, применит другой, замерит снова и оставит лучший. При равенстве вернёт как было."/>
                <ItemsControl ItemsSource="{Binding AbFixes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Margin="16,0,0,0" Content="Проверить" VerticalAlignment="Center" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.StartAbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Strong}"/>
                                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Visibility="{Binding Advice.Count, Converter={StaticResource CountToVis}}">
                <TextBlock Text="Рекомендации — делаете вы" Style="{StaticResource SectionTitle}"/>
                <ItemsControl ItemsSource="{Binding Advice}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Margin="0,0,0,6" HorizontalAlignment="Stretch">
                                <Expander.Header>
                                    <DockPanel>
                                        <Ellipse Style="{StaticResource Dot}" Fill="{Binding Color, Converter={StaticResource ToneToBrush}}"/>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Strong}"/>
                                    </DockPanel>
                                </Expander.Header>
                                <StackPanel Margin="18,4,0,4">
                                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource Body}"/>
                                    <ItemsControl ItemsSource="{Binding ManualSteps}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,2">
                                                    <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10" Margin="0,0,8,0" VerticalAlignment="Top" Padding="0,4,0,0"/>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource Body}"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding LinkItems}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource LinkButton}" Content="{Binding Text}" CommandParameter="{Binding Url}" Margin="0,2"
                                                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Expander Header="Не включено в план" Margin="0,16,0,0" Visibility="{Binding Excluded.Count, Converter={StaticResource CountToVis}}">
                <ItemsControl ItemsSource="{Binding Excluded}" Margin="18,4,0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Caption}" Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
