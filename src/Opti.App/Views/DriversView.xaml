<UserControl x:Class="Opti.App.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Stretch">
            <TextBlock Text="Драйверы" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Secondary}" MaxWidth="680" HorizontalAlignment="Left"
                       Text="Состояние драйверов и ссылки на официальные сайты. Opti ничего не скачивает."/>

            <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="18,16" CornerRadius="{StaticResource RadiusLarge}">
                <StackPanel>
                    <DockPanel>
                        <Border Style="{StaticResource IconTile}" Margin="0,0,14,0" VerticalAlignment="Top">
                            <TextBlock Text="&#xE950;" Style="{StaticResource IconTileGlyph}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Strong}" FontSize="15"/>
                            <TextBlock Text="{Binding BoardText}" Style="{StaticResource Caption}" Visibility="{Binding BoardText, Converter={StaticResource StrToVis}}"/>
                        </StackPanel>
                    </DockPanel>
                    <!-- Кнопки отдельной строкой: на узком окне не наезжают на текст -->
                    <WrapPanel Margin="54,12,0,0">
                        <Button Style="{StaticResource AccentButton}" Content="{Binding OemTitle}" Command="{Binding OpenOemCommand}"
                                Visibility="{Binding HasOem, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Обновления Windows" Command="{Binding OpenOptionalUpdatesCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <CheckBox Content="Только требующие внимания" IsChecked="{Binding OnlyAttention}" Margin="0,12,0,0"/>

            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="0,22,0,8"/>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Padding="16,10">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{Binding LinkTitle}" VerticalAlignment="Center" Margin="16,0,0,0"
                                                        CommandParameter="{Binding Url}" ToolTip="{Binding Url}"
                                                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Tag}" Margin="16,0,0,0" Background="{Binding Tone, Converter={StaticResource ToneToSoft}}">
                                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource TagText}" Foreground="{Binding Tone, Converter={StaticResource ToneToBrush}}"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Strong}"/>
                                                    <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}"/>
                                                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" Margin="0,6,0,0" MaxWidth="640" HorizontalAlignment="Left"
                                                               Visibility="{Binding Hint, Converter={StaticResource StrToVis}}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
