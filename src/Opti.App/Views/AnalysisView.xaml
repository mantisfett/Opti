<UserControl x:Class="Opti.App.Views.AnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Left">
            <TextBlock Text="Результаты анализа" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding DeviceText}" Style="{StaticResource Secondary}"/>

            <!-- Сводка: плитки работают как фильтр списка -->
            <UniformGrid Columns="4" Margin="0,20,-8,0">
                <ToggleButton Style="{StaticResource StatTile}" IsChecked="{Binding FilterCritical}" ToolTip="Показать только критичные">
                    <StackPanel>
                        <TextBlock Text="{Binding CriticalCount}" Style="{StaticResource StatValue}" Foreground="{Binding Source=bad, Converter={StaticResource ToneToBrush}}"/>
                        <TextBlock Text="критично" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Style="{StaticResource StatTile}" IsChecked="{Binding FilterImportant}" ToolTip="Показать только важные">
                    <StackPanel>
                        <TextBlock Text="{Binding ImportantCount}" Style="{StaticResource StatValue}" Foreground="{Binding Source=warn, Converter={StaticResource ToneToBrush}}"/>
                        <TextBlock Text="важно" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Style="{StaticResource StatTile}" IsChecked="{Binding FilterAdvice}" ToolTip="Показать только советы">
                    <StackPanel>
                        <TextBlock Text="{Binding AdviceCount}" Style="{StaticResource StatValue}"/>
                        <TextBlock Text="советов" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Style="{StaticResource StatTile}" IsChecked="{Binding FilterFixable}" ToolTip="Показать то, что Opti исправит сам">
                    <StackPanel>
                        <TextBlock Text="{Binding FixableCount}" Style="{StaticResource StatValue}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="исправит Opti" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </ToggleButton>
            </UniformGrid>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>

            <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="20,18">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Исправить" Margin="16,0,0,0"
                                Command="{Binding AutoFixCommand}" IsEnabled="{Binding CanAutoFix}" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource IconTile}" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="&#xE90F;" Style="{StaticResource IconTileGlyph}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Исправить автоматически" Style="{StaticResource CardTitle}" FontSize="16" LineHeight="22"/>
                            <TextBlock Text="{Binding AutoFixText}" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel Margin="56,12,0,0">
                        <Button Style="{StaticResource LinkButton}" Content="Выбрать исправления вручную" Command="{Binding MeasureBeforeCommand}" Margin="0,0,20,0"/>
                        <Button Style="{StaticResource LinkButton}" Content="Без замера" Command="{Binding SkipToStrategyCommand}" Margin="0,0,20,0"/>
                        <Button Style="{StaticResource LinkButton}" Content="Отчёт в HTML" Command="{Binding ExportReportCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <DockPanel Margin="0,28,0,10">
                <Button DockPanel.Dock="Right" Margin="16,0,0,0" Style="{StaticResource LinkButton}" Content="Показать всё" Command="{Binding ClearFilterCommand}" VerticalAlignment="Bottom"
                        Visibility="{Binding IsFiltered, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="Что найдено" Style="{StaticResource SectionTitle}" Margin="0"/>
            </DockPanel>
            <!-- Пустое состояние -->
            <Border Style="{StaticResource Card}" Padding="24" Visibility="{Binding Findings.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="28" HorizontalAlignment="Center" Foreground="{Binding Source=good, Converter={StaticResource ToneToBrush}}"/>
                    <TextBlock Text="Здесь пусто" Style="{StaticResource Strong}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Проблем такого типа не найдено." Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Findings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Margin="0,0,0,6" HorizontalAlignment="Stretch">
                            <Expander.Header>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Tag}" Margin="12,0,0,0" Background="{Binding Color, Converter={StaticResource ToneToSoft}}">
                                        <TextBlock Text="{Binding SeverityText}" Style="{StaticResource TagText}" Foreground="{Binding Color, Converter={StaticResource ToneToBrush}}"/>
                                    </Border>
                                    <Ellipse Style="{StaticResource Dot}" Fill="{Binding Color, Converter={StaticResource ToneToBrush}}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Strong}"/>
                                        <TextBlock Text="{Binding FixHint}" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel Margin="18,4,0,4">
                                <TextBlock Text="{Binding Explanation}" Style="{StaticResource Body}"/>
                                <ItemsControl ItemsSource="{Binding Evidence}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Mono}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding ManualSteps}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10" Margin="0,0,8,0" VerticalAlignment="Top" Padding="0,4,0,0"/>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Body}"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding LinkItems}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource LinkButton}" Content="{Binding Text}" CommandParameter="{Binding Url}" Margin="0,2"
                                                    Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Компьютер" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}">
                <ItemsControl ItemsSource="{Binding ProfileLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Body}" Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <Expander Header="Что не удалось собрать" Margin="0,8,0,0" Visibility="{Binding Errors.Count, Converter={StaticResource CountToVis}}">
                <ItemsControl ItemsSource="{Binding Errors}" Margin="18,4,0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Caption}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
