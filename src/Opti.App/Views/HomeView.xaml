<UserControl x:Class="Opti.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Пункт списка «что входит» в карточке режима -->
        <DataTemplate x:Key="IncludeItem">
            <DockPanel Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" VerticalAlignment="Top" Margin="0,4,10,0"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="{Binding}" Style="{StaticResource Body}" FontSize="13"/>
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="SkipItem">
            <DockPanel Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Left" Text="&#xE738;" Style="{StaticResource Icon}" FontSize="12" VerticalAlignment="Top" Margin="0,4,10,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="{Binding}" Style="{StaticResource Secondary}" FontSize="13"/>
            </DockPanel>
        </DataTemplate>


        <!-- Карточка режима: название, одна строка сути, глубина изменений, три пункта -->
        <DataTemplate x:Key="ModeCard">
            <StackPanel>
                <DockPanel>
                    <Border Style="{StaticResource IconTile}" Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Icon}" Style="{StaticResource IconTileGlyph}" FontSize="15"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" Margin="0,10,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,14">
                    <Border Style="{StaticResource LevelBar}" Background="{StaticResource BrandGradientBrush}"/>
                    <Border x:Name="Bar2" Style="{StaticResource LevelBar}"/>
                    <Border x:Name="Bar3" Style="{StaticResource LevelBar}"/>
                    <TextBlock Text="{Binding ChangesLevel}" Style="{StaticResource Caption}" Margin="6,0,10,0" VerticalAlignment="Center"/>
                    <Border Style="{StaticResource Tag}" Background="{StaticResource AccentSoftBrush}" Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Рекомендуем" Style="{StaticResource TagText}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    </Border>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Highlights}" ItemTemplate="{StaticResource IncludeItem}" Focusable="False"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level2}" Value="True"><Setter TargetName="Bar2" Property="Background" Value="{StaticResource BrandGradientBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Level3}" Value="True"><Setter TargetName="Bar3" Property="Background" Value="{StaticResource BrandGradientBrush}"/></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Ячейка таблицы сравнения: галочка, прочерк или текст -->
        <DataTemplate x:Key="ComparisonCellTemplate">
            <Grid AutomationProperties.Name="{Binding Spoken}">
                <TextBlock x:Name="Yes" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="14" HorizontalAlignment="Center"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed"/>
                <TextBlock x:Name="No" Text="—" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="Collapsed"/>
                <TextBlock Text="{Binding Text}" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center"
                           VerticalAlignment="Center" Visibility="{Binding Text, Converter={StaticResource StrToVis}}"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsYes}" Value="True"><Setter TargetName="Yes" Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding IsNo}" Value="True"><Setter TargetName="No" Property="Visibility" Value="Visible"/></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Stretch">
            <!-- Шапка: логотип, заголовок, одна фраза -->
            <DockPanel Margin="0,0,0,8">
                <Image DockPanel.Dock="Left" Source="pack://application:,,,/Assets/opti.png" Width="56" Height="56" Margin="0,0,18,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Найдём, что тормозит" Style="{StaticResource PageTitle}" Margin="0"/>
                    <TextBlock Text="Анализ ничего не меняет. Исправления откатываются, результат подтверждается замером." Style="{StaticResource Secondary}"/>
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16,12" Visibility="{Binding HasOpenSession, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Продолжить" Command="{Binding ContinueSessionCommand}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <Border Style="{StaticResource IconTile}" Width="36" Height="36" Margin="0,0,14,0">
                        <TextBlock Text="&#xE823;" Style="{StaticResource IconTileGlyph}" FontSize="16"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Незавершённая сессия" Style="{StaticResource Strong}"/>
                        <TextBlock Text="{Binding OpenSessionText}" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </DockPanel>
            </Border>


            <!-- Режим -->
            <TextBlock Text="Выберите режим" Style="{StaticResource SectionTitle}"/>
            <ListBox Style="{StaticResource ModeCardList}" ItemsSource="{Binding Goals}" SelectedItem="{Binding SelectedGoal}"
                     ItemTemplate="{StaticResource ModeCard}" AutomationProperties.Name="Режим оптимизации"/>

            <DockPanel Margin="0,20,0,0">
                <Button DockPanel.Dock="Left" Style="{StaticResource AccentButton}" Padding="24,9" Command="{Binding AnalyzeCommand}" AutomationProperties.Name="Проанализировать">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" Foreground="White"/>
                        <TextBlock Text="Проанализировать" FontSize="15"/>
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Left" Content="Отмена" Command="{Binding CancelAnalysisCommand}" Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}"
                        VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding SelectedGoalHint}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </DockPanel>
            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}">
                <ProgressBar IsIndeterminate="True" MaxWidth="420" HorizontalAlignment="Stretch"/>
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Подробное сравнение — по запросу, чтобы не перегружать главную -->
            <Expander Header="Подробное сравнение режимов" Margin="0,24,0,0" Padding="0">
                <StackPanel Margin="0,12,0,0">
            <!-- Чем отличаются режимы -->
            <Border Style="{StaticResource Card}" Padding="0" CornerRadius="{StaticResource RadiusLarge}">
                <StackPanel>
                    <!-- Заголовок таблицы -->
                    <Grid Margin="20,14,20,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="112"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Что делает Opti" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Максимальная" Style="{StaticResource Strong}" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Баланс" Style="{StaticResource Strong}" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="Минимальная" Style="{StaticResource Strong}" FontSize="13" HorizontalAlignment="Center"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Comparison}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="20,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="336"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Feature}" Style="{StaticResource Body}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}" ItemTemplate="{StaticResource ComparisonCellTemplate}" Focusable="False"
                                                      VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
                </StackPanel>
            </Expander>

            <!-- Инструменты -->
            <TextBlock Text="Инструменты" Style="{StaticResource SectionTitle}"/>
            <UniformGrid Rows="1" Margin="0,0,-12,0">
                <Button Style="{StaticResource ToolTile}" Command="{Binding OpenCleanupCommand}" Margin="0,0,12,0">
                    <StackPanel>
                        <Border Style="{StaticResource IconTile}" Width="32" Height="32" CornerRadius="8"><TextBlock Text="&#xEA99;" Style="{StaticResource IconTileGlyph}" FontSize="15"/></Border>
                        <TextBlock Text="Очистка" Style="{StaticResource Strong}" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding DiskText}" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolTile}" Command="{Binding OpenDriversCommand}" Margin="0,0,12,0">
                    <StackPanel>
                        <Border Style="{StaticResource IconTile}" Width="32" Height="32" CornerRadius="8"><TextBlock Text="&#xE950;" Style="{StaticResource IconTileGlyph}" FontSize="15"/></Border>
                        <TextBlock Text="Драйверы" Style="{StaticResource Strong}" Margin="0,12,0,0"/>
                        <TextBlock Text="Состояние и ссылки на сайты производителей" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolTile}" Command="{Binding OpenSoftwareCommand}" Margin="0,0,12,0">
                    <StackPanel>
                        <Border Style="{StaticResource IconTile}" Width="32" Height="32" CornerRadius="8"><TextBlock Text="&#xE71D;" Style="{StaticResource IconTileGlyph}" FontSize="15"/></Border>
                        <TextBlock Text="Полезные программы" Style="{StaticResource Strong}" Margin="0,12,0,0"/>
                        <TextBlock Text="Только официальные источники" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
