<UserControl x:Class="Opti.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Пункт списка «что входит» в карточке режима -->
        <DataTemplate x:Key="IncludeItem">
            <DockPanel Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" VerticalAlignment="Top" Margin="0,4,10,0"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="{Binding}" Style="{StaticResource Body}" FontSize="13"/>
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="SkipItem">
            <DockPanel Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Left" Text="&#xE738;" Style="{StaticResource Icon}" FontSize="12" VerticalAlignment="Top" Margin="0,4,10,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="{Binding}" Style="{StaticResource Secondary}" FontSize="13"/>
            </DockPanel>
        </DataTemplate>

        <!-- Карточка режима -->
        <DataTemplate x:Key="ModeCard">
            <DockPanel>
                <!-- Шапка: значок, название, плашка «Рекомендуем» -->
                <StackPanel DockPanel.Dock="Top">
                    <Border Style="{StaticResource IconTile}" Margin="0,0,0,14">
                        <TextBlock Text="{Binding Icon}" Style="{StaticResource IconTileGlyph}"/>
                    </Border>
                    <WrapPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" Margin="0,0,8,0"/>
                        <Border Style="{StaticResource Tag}" Background="{StaticResource AccentSoftBrush}" Margin="0,2,0,0"
                                Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Рекомендуем" Style="{StaticResource TagText}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" Margin="0,2,0,0"/>

                    <!-- Глубина изменений: 1–3 деления -->
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Border Style="{StaticResource LevelBar}" Background="{StaticResource BrandGradientBrush}"/>
                        <Border x:Name="Bar2" Style="{StaticResource LevelBar}"/>
                        <Border x:Name="Bar3" Style="{StaticResource LevelBar}"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="6,0,0,0" VerticalAlignment="Center">
                            <Run Text="Изменений:"/> <Run Text="{Binding ChangesLevel, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" FontSize="13" Margin="0,14,0,0"/>
                    <Border Style="{StaticResource Divider}" Margin="0,16,0,14"/>
                </StackPanel>

                <!-- Подвал карточки прижат к низу, чтобы карточки разной длины выглядели ровно -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Left" Text="&#xE9CA;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Style="{StaticResource Caption}"><Run Text="Нагрев и шум:"/> <Run Text="{Binding HeatLevel, Mode=OneWay}"/></TextBlock>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding Verification}" Style="{StaticResource Caption}"/>
                    </DockPanel>
                </StackPanel>

                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Includes}" ItemTemplate="{StaticResource IncludeItem}" Focusable="False"/>
                    <ItemsControl ItemsSource="{Binding Skips}" ItemTemplate="{StaticResource SkipItem}" Focusable="False"/>
                </StackPanel>
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level2}" Value="True">
                    <Setter TargetName="Bar2" Property="Background" Value="{StaticResource BrandGradientBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level3}" Value="True">
                    <Setter TargetName="Bar3" Property="Background" Value="{StaticResource BrandGradientBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Ячейка таблицы сравнения: галочка, прочерк или текст -->
        <DataTemplate x:Key="ComparisonCellTemplate">
            <Grid AutomationProperties.Name="{Binding Spoken}">
                <TextBlock x:Name="Yes" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="14" HorizontalAlignment="Center"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed"/>
                <TextBlock x:Name="No" Text="—" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="Collapsed"/>
                <TextBlock Text="{Binding Text}" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center"
                           VerticalAlignment="Center" Visibility="{Binding Text, Converter={StaticResource StrToVis}}"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsYes}" Value="True"><Setter TargetName="Yes" Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding IsNo}" Value="True"><Setter TargetName="No" Property="Visibility" Value="Visible"/></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="1040" HorizontalAlignment="Left">
            <!-- Фирменный баннер: тёмная поверхность с логотипом в обеих темах.
                 Отрицательные поля у подсветки — чтобы она не растягивала баннер по высоте. -->
            <Border CornerRadius="{StaticResource RadiusLarge}" Background="{StaticResource BrandHeroBrush}" ClipToBounds="True">
                <Grid>
                    <Ellipse Width="460" Height="460" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-400,-150,-400" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#5519B4F6" Offset="0"/>
                                <GradientStop Color="#001565FF" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <DockPanel Margin="32,26,32,22">
                        <Image DockPanel.Dock="Right" Source="pack://application:,,,/Assets/opti.png" Width="96" Height="96" VerticalAlignment="Center"
                               Margin="24,0,4,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel>
                            <Image Source="pack://application:,,,/Assets/opti-wordmark.png" Height="44" HorizontalAlignment="Left" Margin="-11,-6,0,8"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Найдём, что тормозит" Style="{StaticResource HeroTitle}"/>
                            <TextBlock Style="{StaticResource HeroText}" MaxWidth="560" HorizontalAlignment="Left" Margin="0,8,0,16"
                                       Text="Opti проверит компьютер, драйверы и реестр, исправит только то, что действительно мешает, и покажет результат честным замером."/>
                            <WrapPanel>
                                <Border Style="{StaticResource HeroChip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" Foreground="#7FE3FF" Margin="0,0,7,0"/>
                                        <TextBlock Text="Анализ только читает" Foreground="#E3EBF7" FontSize="12.5"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource HeroChip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE777;" Style="{StaticResource Icon}" FontSize="12" Foreground="#7FE3FF" Margin="0,0,7,0"/>
                                        <TextBlock Text="Откат любого изменения" Foreground="#E3EBF7" FontSize="12.5"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource HeroChip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D2;" Style="{StaticResource Icon}" FontSize="12" Foreground="#7FE3FF" Margin="0,0,7,0"/>
                                        <TextBlock Text="Замер «до» и «после»" Foreground="#E3EBF7" FontSize="12.5"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="16,12" Visibility="{Binding HasOpenSession, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Продолжить" Command="{Binding ContinueSessionCommand}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <Border Style="{StaticResource IconTile}" Width="36" Height="36" Margin="0,0,14,0">
                        <TextBlock Text="&#xE823;" Style="{StaticResource IconTileGlyph}" FontSize="16"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Незавершённая сессия" Style="{StaticResource Strong}"/>
                        <TextBlock Text="{Binding OpenSessionText}" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Режим -->
            <TextBlock Text="Насколько глубоко оптимизировать" Style="{StaticResource SectionTitle}"/>
            <TextBlock Style="{StaticResource SectionLead}"
                       Text="Во всех режимах Opti сначала ищет проблемы и меняет только то, что нашёл. Режимы отличаются тем, что будет отмечено по умолчанию. Перед применением список можно поправить, а любое изменение откатить в «Истории»."/>
            <ListBox Style="{StaticResource ModeCardList}" ItemsSource="{Binding Goals}" SelectedItem="{Binding SelectedGoal}"
                     ItemTemplate="{StaticResource ModeCard}" AutomationProperties.Name="Режим оптимизации"/>

            <DockPanel Margin="0,20,0,0">
                <Button DockPanel.Dock="Left" Style="{StaticResource AccentButton}" Padding="28,10" Command="{Binding AnalyzeCommand}" AutomationProperties.Name="Проанализировать">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" Foreground="White"/>
                        <TextBlock Text="Проанализировать" FontSize="15"/>
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Left" Content="Отмена" Command="{Binding CancelAnalysisCommand}" Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}"
                        VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding SelectedGoalHint}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </DockPanel>
            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}">
                <ProgressBar IsIndeterminate="True" MaxWidth="420" HorizontalAlignment="Stretch"/>
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Чем отличаются режимы -->
            <TextBlock Text="Чем отличаются режимы" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}" Padding="0" CornerRadius="{StaticResource RadiusLarge}">
                <StackPanel>
                    <!-- Заголовок таблицы -->
                    <Grid Margin="20,14,20,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="112"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Что делает Opti" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Максимальная" Style="{StaticResource Strong}" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Баланс" Style="{StaticResource Strong}" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="Минимальная" Style="{StaticResource Strong}" FontSize="13" HorizontalAlignment="Center"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Comparison}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="20,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="336"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Feature}" Style="{StaticResource Body}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}" ItemTemplate="{StaticResource ComparisonCellTemplate}" Focusable="False"
                                                      VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Caption}" Margin="2,8,0,0"
                       Text="Предупреждения о железе (перегрев, HDD, мало памяти, XMP) и ссылки на драйверы показываются во всех режимах — они ничего не меняют сами."/>

            <!-- Ещё -->
            <TextBlock Text="Инструменты" Style="{StaticResource SectionTitle}"/>
            <UniformGrid Rows="1" Margin="0,0,-12,0">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,16" CornerRadius="{StaticResource RadiusLarge}">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Content="Открыть" Command="{Binding OpenCleanupCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                        <Border DockPanel.Dock="Top" Style="{StaticResource IconTile}" Margin="0,0,0,12">
                            <TextBlock Text="&#xEA99;" Style="{StaticResource IconTileGlyph}"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Бережная очистка" Style="{StaticResource Strong}" FontSize="15"/>
                            <TextBlock Text="{Binding DiskText}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                            <TextBlock Text="Места мало — очистка может помочь." Style="{StaticResource Caption}" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Visibility="{Binding DiskLow, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,16" CornerRadius="{StaticResource RadiusLarge}">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Content="Проверить" Command="{Binding OpenDriversCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                        <Border DockPanel.Dock="Top" Style="{StaticResource IconTile}" Margin="0,0,0,12">
                            <TextBlock Text="&#xE950;" Style="{StaticResource IconTileGlyph}"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Драйверы" Style="{StaticResource Strong}" FontSize="15"/>
                            <TextBlock Text="Видео, сеть, звук, чипсет — со ссылками на официальные сайты." Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,16" CornerRadius="{StaticResource RadiusLarge}">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Content="Открыть" Command="{Binding OpenSoftwareCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                        <Border DockPanel.Dock="Top" Style="{StaticResource IconTile}" Margin="0,0,0,12">
                            <TextBlock Text="&#xE71D;" Style="{StaticResource IconTileGlyph}"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Полезные программы" Style="{StaticResource Strong}" FontSize="15"/>
                            <TextBlock Text="От WizTree до Discord — только официальные источники." Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
