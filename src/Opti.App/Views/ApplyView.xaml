<UserControl x:Class="Opti.App.Views.ApplyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Stretch">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding Headline}" Style="{StaticResource Body}"/>
            <TextBlock Text="{Binding RestorePoint}" Style="{StaticResource Caption}" Margin="0,4,0,0" Visibility="{Binding RestorePoint, Converter={StaticResource StrToVis}}"/>

            <Border Style="{StaticResource Card}" Margin="0,20,0,8" Padding="20,18">
                <StackPanel>
                    <TextBlock Text="{Binding NextText}" Style="{StaticResource Body}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource AccentButton}" Content="Перезагрузить сейчас" Command="{Binding RebootNowCommand}"
                                Visibility="{Binding RebootRequired, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource AccentButton}" Content="Продолжить" Command="{Binding ContinueCommand}"
                                Visibility="{Binding RebootRequired, Converter={StaticResource InvBoolToVis}}"/>
                        <Button Content="Откатить изменения" Command="{Binding RollbackCommand}"
                                Visibility="{Binding SuggestRollback, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding PostRebootItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <Ellipse Style="{StaticResource Dot}" Fill="{Binding Color, Converter={StaticResource ToneToBrush}}"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Strong}"/>
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Что сделано" Style="{StaticResource SectionTitle}" Visibility="{Binding Log.Count, Converter={StaticResource CountToVis}}"/>
            <ItemsControl ItemsSource="{Binding Log}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Margin="0,0,0,6" HorizontalAlignment="Stretch">
                            <Expander.Header>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="320"/>
                                    <Ellipse Style="{StaticResource Dot}" Fill="{Binding Color, Converter={StaticResource ToneToBrush}}"/>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Strong}"/>
                                </DockPanel>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding Details}" Margin="18,4,0,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Mono}" Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
