<UserControl x:Class="Opti.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Stretch">
            <TextBlock Text="Автозагрузка" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Что запускается вместе с Windows. Отключение обратимо: программы не удаляются, переключатель возвращает всё как было." Style="{StaticResource Secondary}"/>

            <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="18,16" CornerRadius="{StaticResource RadiusLarge}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Отключить рекомендуемые" Command="{Binding DisableSuggestedCommand}" Margin="16,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding HasSuggested, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Strong}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsOn}" VerticalAlignment="Center" Margin="16,0,0,0"
                                          IsEnabled="{Binding CanToggle}" AutomationProperties.Name="{Binding Name}"/>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Strong}" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource Tag}" Margin="10,0,0,0" Background="{Binding AdviceTone, Converter={StaticResource ToneToSoft}}"
                                                Visibility="{Binding ShowAdvice, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding AdviceText}" Style="{StaticResource TagText}" Foreground="{Binding AdviceTone, Converter={StaticResource ToneToBrush}}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding Category}" Style="{StaticResource Caption}"/>
                                        <TextBlock Text="·" Style="{StaticResource Caption}" Margin="6,0"/>
                                        <TextBlock Text="{Binding Source}" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Command}" Style="{StaticResource Mono}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip="{Binding Command}"/>
                                    <TextBlock Text="{Binding Error}" Style="{StaticResource Caption}" Foreground="{Binding Source=bad, Converter={StaticResource ToneToBrush}}"
                                               Visibility="{Binding Error, Converter={StaticResource StrToVis}}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource Caption}" Margin="2,12,0,0"
                       Text="Время загрузки Opti не измеряет: «влияние на запуск» в Диспетчере задач берётся из системной телеметрии. Защита, драйверы устройств и сам Opti заблокированы от случайного отключения."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
