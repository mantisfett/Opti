<UserControl x:Class="Opti.App.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Opti.App.Controls">
    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
            <DockPanel Margin="0,4,0,0">
                <Ellipse Style="{StaticResource Dot}" Width="10" Height="10" Fill="{Binding MessageColor, Converter={StaticResource ToneToBrush}}"/>
                <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" FontSize="15" LineHeight="22"/>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Warnings}" Margin="20,6,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource Caption}" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Cards}" Margin="0,20,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="232" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}"/>
                                <TextBlock Margin="0,6,0,2">
                                    <Run Text="{Binding Before, Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="16"/>
                                    <Run Text=" → " Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="16"/>
                                    <Run Text="{Binding After, Mode=OneWay}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"/>
                                    <Run Text="{Binding Unit, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="{Binding Color, Converter={StaticResource ToneToBrush}}">
                                    <Run Text="{Binding Delta, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text="{Binding VerdictText, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Ci}" Style="{StaticResource Caption}" Margin="0,4,0,0" ToolTip="{Binding CiDetails}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding FlipText}" Style="{StaticResource Body}" Visibility="{Binding FlipText, Converter={StaticResource StrToVis}}"/>

            <TextBlock Text="Фреймтайм" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding BeforeLabel}" Style="{StaticResource Caption}" Margin="6,0,18,0"/>
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding AfterLabel}" Style="{StaticResource Caption}" Margin="6,0,0,0"/>
                    </StackPanel>
                    <c:FrameTimeChart Height="220" Primary="{Binding BeforeFrames}" Secondary="{Binding AfterFrames}"
                                      PrimaryBrush="{DynamicResource TextFillColorTertiaryBrush}" SecondaryBrush="{DynamicResource AccentFillColorDefaultBrush}"/>
                </StackPanel>
            </Border>
            <TextBlock Text="Распределение" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}">
                <c:HistogramChart Height="200" Primary="{Binding BeforeFrames}" Secondary="{Binding AfterFrames}"
                                  PrimaryBrush="{DynamicResource TextFillColorTertiaryBrush}" SecondaryBrush="{DynamicResource AccentFillColorDefaultBrush}"/>
            </Border>

            <StackPanel Visibility="{Binding AppliedFixes.Count, Converter={StaticResource CountToVis}}">
                <TextBlock Text="Что изменено" Style="{StaticResource SectionTitle}"/>
                <ItemsControl ItemsSource="{Binding AppliedFixes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Margin="0,0,0,6" HorizontalAlignment="Stretch">
                                <Expander.Header>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Откатить" Margin="12,0,0,0" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.RollbackFixCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Visibility="{Binding RolledBack, Converter={StaticResource InvBoolToVis}}"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Strong}"/>
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Expander.Header>
                                <TextBlock Text="{Binding Changes}" Style="{StaticResource Mono}" Margin="18,4,0,4"/>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <WrapPanel Margin="0,16,0,0">
                <Button Style="{StaticResource AccentButton}" Content="Готово" Command="{Binding FinishCommand}" Margin="0,0,8,8"/>
                <Button Content="Отчёт в HTML" Command="{Binding ExportHtmlCommand}" Margin="0,0,8,8"/>
                <Button Content="Кадры в CSV" Command="{Binding ExportCsvCommand}" Margin="0,0,8,8"/>
                <Button Content="Откатить всё" Command="{Binding RollbackSessionCommand}" Margin="0,0,8,8"
                        Visibility="{Binding IsAb, Converter={StaticResource InvBoolToVis}}"/>
            </WrapPanel>
            <TextBlock Text="Результат хуже, чем было, — рекомендуется откатить." Style="{StaticResource Caption}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Visibility="{Binding SuggestRollback, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
