<UserControl x:Class="Opti.App.Views.SoftwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Stretch">
            <TextBlock Text="Полезные программы" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Secondary}" MaxWidth="680" HorizontalAlignment="Left"
                       Text="Только официальные сайты разработчиков."/>
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,26,0,10">
                                <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="0"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Width="300" Margin="0,0,8,8">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Bottom" Content="Официальный сайт" HorizontalAlignment="Left" Margin="0,10,0,0"
                                                        CommandParameter="{Binding}" ToolTip="{Binding Url}"
                                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Strong}"/>
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" FontStyle="Italic" Margin="0,4,0,0"
                                                               Visibility="{Binding Note, Converter={StaticResource StrToVis}}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
