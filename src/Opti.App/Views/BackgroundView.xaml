<UserControl x:Class="Opti.App.Views.BackgroundView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Stretch">
            <TextBlock Text="Фон" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Что грузит ПК, пока вы играете. Закрыть программу можно по кнопке — навсегда ничего не отключается." Style="{StaticResource Secondary}"/>

            <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="18,16" CornerRadius="{StaticResource RadiusLarge}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Проверить сейчас" Command="{Binding ScanCommand}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Самые тяжёлые программы" Style="{StaticResource CardTitle}" FontSize="16" LineHeight="22"/>
                            <TextBlock Text="Короткий замер процессора и памяти по программам (около 2 секунд). Системные процессы и службы не показываются." Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar IsIndeterminate="True" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,4" Visibility="{Binding Summary, Converter={StaticResource StrToVis}}">
                        <Ellipse Style="{StaticResource Dot}" Fill="{Binding SummaryTone, Converter={StaticResource ToneToBrush}}"/>
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Strong}" MaxWidth="760"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="96"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Strong}" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Category}" Style="{StaticResource Caption}"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding CpuText}" Style="{StaticResource Strong}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{Binding Tone, Converter={StaticResource ToneToBrush}}" ToolTip="Доля всего процессора"/>
                                    <TextBlock Grid.Column="2" Text="{Binding MemoryText}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Занятая память"/>
                                    <Button Grid.Column="3" Content="Закрыть" HorizontalAlignment="Right" CommandParameter="{Binding}" Visibility="{Binding CanClose, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.CloseAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Caption}" Margin="2,12,0,0"
                       Text="Opti не «ускоряет игры» чисткой памяти и не убивает процессы сам: закрывает только то, что вы выбрали."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
