<UserControl x:Class="Opti.App.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Stretch">
            <TextBlock Text="Сеть" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Куда связь быстрее и стабильнее, и какой DNS отвечает быстрее. Только измерения." Style="{StaticResource Secondary}"/>

            <!-- Регионы -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="18,16" CornerRadius="{StaticResource RadiusLarge}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Проверить связь" Command="{Binding RunRegionsCommand}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Задержка до регионов" Style="{StaticResource CardTitle}" FontSize="16" LineHeight="22"/>
                            <TextBlock Text="Время соединения, разброс и потери до облачных регионов, где часто стоят игровые серверы" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar IsIndeterminate="True" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" Margin="0,6,0,0" Visibility="{Binding ProgressText, Converter={StaticResource StrToVis}}"/>
                    <TextBlock Text="{Binding RegionsSummary}" Style="{StaticResource Strong}" Margin="0,14,0,4" Visibility="{Binding RegionsSummary, Converter={StaticResource StrToVis}}"/>
                    <ItemsControl ItemsSource="{Binding Regions}" Focusable="False" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailText}"/>
                                    <Border Grid.Column="1" Height="6" CornerRadius="3" Margin="8,0,12,0" Background="{DynamicResource ControlStrongStrokeColorDisabledBrush}" VerticalAlignment="Center">
                                        <ProgressBar Value="{Binding Bar, Mode=OneWay}" Maximum="1" Height="6" Foreground="{Binding Tone, Converter={StaticResource ToneToBrush}}"
                                                     Background="Transparent" BorderThickness="0"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding MedianText}" Style="{StaticResource Strong}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{Binding Tone, Converter={StaticResource ToneToBrush}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- DNS -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,16" CornerRadius="{StaticResource RadiusLarge}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Проверить DNS" Command="{Binding RunDnsCommand}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Скорость DNS" Style="{StaticResource CardTitle}" FontSize="16" LineHeight="22"/>
                            <TextBlock Text="Быстрый DNS ускоряет вход в игру и поиск матча. На пинг самого матча он не влияет." Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding DnsSummary}" Style="{StaticResource Strong}" Margin="0,14,0,4" Visibility="{Binding DnsSummary, Converter={StaticResource StrToVis}}"/>
                    <ItemsControl ItemsSource="{Binding DnsRows}" Focusable="False" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4">
                                    <Button DockPanel.Dock="Right" Content="Применить" Margin="12,0,0,0" CommandParameter="{Binding}" Visibility="{Binding CanApply, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.ApplyDnsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding MedianText}" Style="{StaticResource Strong}" MinWidth="64" TextAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{Binding Tone, Converter={StaticResource ToneToBrush}}"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Caption}" Margin="2,12,0,0"
                       Text="Что ещё снижает пинг: кабель вместо Wi-Fi, закрытые загрузки в фоне, «Оптимизация доставки» только в локальной сети (находка в анализе). Настройки вроде «TCP-твиков» Opti не предлагает: измеримого эффекта у них нет."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
