<UserControl x:Class="Opti.App.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Stretch">
            <TextBlock Text="Сеть" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Куда связь быстрее и стабильнее, и какой DNS отвечает быстрее. Только измерения." Style="{StaticResource Secondary}"/>

            <!-- Регионы -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="18,16" CornerRadius="{StaticResource RadiusLarge}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Проверить связь" Command="{Binding RunRegionsCommand}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Задержка до регионов" Style="{StaticResource CardTitle}" FontSize="16" LineHeight="22"/>
                            <TextBlock Text="Время соединения, разброс и потери до облачных регионов, где часто стоят игровые серверы" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar IsIndeterminate="True" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" Margin="0,6,0,0" Visibility="{Binding ProgressText, Converter={StaticResource StrToVis}}"/>
                    <TextBlock Text="{Binding RegionsSummary}" Style="{StaticResource Strong}" Margin="0,14,0,4" Visibility="{Binding RegionsSummary, Converter={StaticResource StrToVis}}"/>
                    <ItemsControl ItemsSource="{Binding Regions}" Focusable="False" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailText}"/>
                                    <Border Grid.Column="1" Height="6" CornerRadius="3" Margin="8,0,12,0" Background="{DynamicResource ControlStrongStrokeColorDisabledBrush}" VerticalAlignment="Center">
                                        <ProgressBar Value="{Binding Bar, Mode=OneWay}" Maximum="1" Height="6" Foreground="{Binding Tone, Converter={StaticResource ToneToBrush}}"
                                                     Background="Transparent" BorderThickness="0"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding MedianText}" Style="{StaticResource Strong}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{Binding Tone, Converter={StaticResource ToneToBrush}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Живой пинг -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,16" CornerRadius="{StaticResource RadiusLarge}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding ToggleMonitorCommand}" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="Запустить"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsMonitoring}" Value="True"><Setter Property="Content" Value="Остановить"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Живой пинг" Style="{StaticResource CardTitle}" FontSize="16" LineHeight="22"/>
                            <TextBlock Text="Пинг каждые полсекунды: запустите, сверните Opti и играйте — потом посмотрите, были ли скачки и потери" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBox Text="{Binding MonitorTarget, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,0" Width="420" HorizontalAlignment="Left" IsEnabled="{Binding CanEditMonitorTarget}"
                             AutomationProperties.Name="Сервер для живого пинга" ToolTip="Имя сервера или IP-адрес"/>
                    <ItemsControl ItemsSource="{Binding Bars}" Focusable="False" Height="48" Margin="0,14,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="6" Margin="0,0,2,0" Height="{Binding Height}" VerticalAlignment="Bottom" CornerRadius="2" ToolTip="{Binding Tip}"
                                        Background="{Binding Tone, Converter={StaticResource ToneToBrush}}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <UniformGrid Columns="6" Margin="0,14,0,0">
                        <StackPanel><TextBlock Text="сейчас" Style="{StaticResource Caption}"/><TextBlock Text="{Binding MonitorLast}" Style="{StaticResource Strong}" Foreground="{Binding MonitorTone, Converter={StaticResource ToneToBrush}}"/></StackPanel>
                        <StackPanel><TextBlock Text="среднее, мс" Style="{StaticResource Caption}"/><TextBlock Text="{Binding MonitorAvg}" Style="{StaticResource Strong}"/></StackPanel>
                        <StackPanel><TextBlock Text="лучшее, мс" Style="{StaticResource Caption}"/><TextBlock Text="{Binding MonitorMin}" Style="{StaticResource Strong}"/></StackPanel>
                        <StackPanel><TextBlock Text="худшее, мс" Style="{StaticResource Caption}"/><TextBlock Text="{Binding MonitorMax}" Style="{StaticResource Strong}"/></StackPanel>
                        <StackPanel><TextBlock Text="разброс, мс" Style="{StaticResource Caption}"/><TextBlock Text="{Binding MonitorJitter}" Style="{StaticResource Strong}"/></StackPanel>
                        <StackPanel><TextBlock Text="потери" Style="{StaticResource Caption}"/><TextBlock Text="{Binding MonitorLoss}" Style="{StaticResource Strong}"/></StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Нагрузка на канал -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,16" CornerRadius="{StaticResource RadiusLarge}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Проверить под нагрузкой" Command="{Binding RunBloatCommand}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Пинг под нагрузкой" Style="{StaticResource CardTitle}" FontSize="16" LineHeight="22"/>
                            <TextBlock Text="Растёт ли пинг, когда канал занят скачиванием или отдачей. Около 30 секунд; на время проверки качаются тестовые данные с speed.cloudflare.com" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,4" Visibility="{Binding BloatSummary, Converter={StaticResource StrToVis}}">
                        <Border Style="{StaticResource Tag}" Margin="0,0,12,0" Background="{Binding BloatTone, Converter={StaticResource ToneToSoft}}" Visibility="{Binding BloatGrade, Converter={StaticResource StrToVis}}">
                            <TextBlock Text="{Binding BloatGrade}" Style="{StaticResource TagText}" FontSize="16" Foreground="{Binding BloatTone, Converter={StaticResource ToneToBrush}}"/>
                        </Border>
                        <TextBlock Text="{Binding BloatSummary}" Style="{StaticResource Strong}" MaxWidth="740" VerticalAlignment="Center"/>
                    </StackPanel>
                    <UniformGrid Columns="3" Margin="0,8,0,0" Visibility="{Binding BloatSummary, Converter={StaticResource StrToVis}}">
                        <StackPanel><TextBlock Text="в простое" Style="{StaticResource Caption}"/><TextBlock Text="{Binding BloatIdle}" Style="{StaticResource Strong}"/></StackPanel>
                        <StackPanel><TextBlock Text="под скачиванием" Style="{StaticResource Caption}"/><TextBlock Text="{Binding BloatDown}" Style="{StaticResource Strong}"/></StackPanel>
                        <StackPanel><TextBlock Text="под отдачей" Style="{StaticResource Caption}"/><TextBlock Text="{Binding BloatUp}" Style="{StaticResource Strong}"/></StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Кто грузит сеть -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,16" CornerRadius="{StaticResource RadiusLarge}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Замерить трафик" Command="{Binding RunTrafficCommand}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Кто грузит сеть" Style="{StaticResource CardTitle}" FontSize="16" LineHeight="22"/>
                            <TextBlock Text="15 секунд: сколько каждая программа отдаёт и качает. Фоновая загрузка — частая причина скачков пинга. Видны только объёмы, не содержимое" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,4" Visibility="{Binding TrafficSummary, Converter={StaticResource StrToVis}}">
                        <Ellipse Style="{StaticResource Dot}" Fill="{Binding TrafficTone, Converter={StaticResource ToneToBrush}}"/>
                        <TextBlock Text="{Binding TrafficSummary}" Style="{StaticResource Strong}" MaxWidth="760"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding TrafficRows}" Focusable="False" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" Height="6" CornerRadius="3" Margin="8,0,12,0" Background="{DynamicResource ControlStrongStrokeColorDisabledBrush}" VerticalAlignment="Center">
                                        <ProgressBar Value="{Binding Bar, Mode=OneWay}" Maximum="1" Height="6" Foreground="{Binding Tone, Converter={StaticResource ToneToBrush}}" Background="Transparent" BorderThickness="0"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding UpText}" Style="{StaticResource Strong}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Отдаёт"/>
                                    <TextBlock Grid.Column="3" Text="{Binding DownText}" Style="{StaticResource Strong}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Качает"/>
                                    <Button Grid.Column="4" Content="Закрыть" HorizontalAlignment="Right" CommandParameter="{Binding}" Visibility="{Binding CanClose, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.CloseTrafficAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="отдаёт · качает" Style="{StaticResource Caption}" Margin="0,4,0,0" HorizontalAlignment="Right" Visibility="{Binding TrafficSummary, Converter={StaticResource StrToVis}}"/>
                </StackPanel>
            </Border>

            <!-- Wi-Fi -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,16" CornerRadius="{StaticResource RadiusLarge}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Проверить Wi-Fi" Command="{Binding RunWifiCommand}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Wi-Fi: загруженность каналов" Style="{StaticResource CardTitle}" FontSize="16" LineHeight="22"/>
                            <TextBlock Text="Сколько соседних сетей мешает на вашем канале и какой канал свободнее. Для игр лучше 5 ГГц или кабель" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,4" Visibility="{Binding WifiSummary, Converter={StaticResource StrToVis}}">
                        <Ellipse Style="{StaticResource Dot}" Fill="{Binding WifiTone, Converter={StaticResource ToneToBrush}}"/>
                        <TextBlock Text="{Binding WifiSummary}" Style="{StaticResource Strong}" MaxWidth="760"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding WifiRows}" Focusable="False" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Height="6" CornerRadius="3" Margin="8,0,12,0" Background="{DynamicResource ControlStrongStrokeColorDisabledBrush}" VerticalAlignment="Center">
                                        <ProgressBar Value="{Binding Bar, Mode=OneWay}" Maximum="1" Height="6" Foreground="{Binding Tone, Converter={StaticResource ToneToBrush}}" Background="Transparent" BorderThickness="0"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Caption}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <Border Grid.Column="3" Style="{StaticResource Tag}" HorizontalAlignment="Right" Background="{Binding Tone, Converter={StaticResource ToneToSoft}}" Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Tag}" Style="{StaticResource TagText}" Foreground="{Binding Tone, Converter={StaticResource ToneToBrush}}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- DNS -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,16" CornerRadius="{StaticResource RadiusLarge}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Проверить DNS" Command="{Binding RunDnsCommand}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Скорость DNS" Style="{StaticResource CardTitle}" FontSize="16" LineHeight="22"/>
                            <TextBlock Text="Быстрый DNS ускоряет вход в игру и поиск матча. На пинг самого матча он не влияет." Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding DnsSummary}" Style="{StaticResource Strong}" Margin="0,14,0,4" Visibility="{Binding DnsSummary, Converter={StaticResource StrToVis}}"/>
                    <ItemsControl ItemsSource="{Binding DnsRows}" Focusable="False" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4">
                                    <Button DockPanel.Dock="Right" Content="Применить" Margin="12,0,0,0" CommandParameter="{Binding}" Visibility="{Binding CanApply, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.ApplyDnsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding MedianText}" Style="{StaticResource Strong}" MinWidth="64" TextAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{Binding Tone, Converter={StaticResource ToneToBrush}}"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Маршрут -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,16" CornerRadius="{StaticResource RadiusLarge}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Проверить маршрут" Command="{Binding RunRouteCommand}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Маршрут до сервера" Style="{StaticResource CardTitle}" FontSize="16" LineHeight="22"/>
                            <TextBlock Text="Где теряется время: дома, у провайдера или на дальнем участке" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBox Text="{Binding RouteTarget, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,0" MaxWidth="420" HorizontalAlignment="Left" Width="420"
                             AutomationProperties.Name="Сервер для проверки маршрута" ToolTip="Имя сервера или IP-адрес; после проверки связи подставляется ближайший регион"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,4" Visibility="{Binding RouteSummary, Converter={StaticResource StrToVis}}">
                        <Ellipse Style="{StaticResource Dot}" Fill="{Binding RouteTone, Converter={StaticResource ToneToBrush}}"/>
                        <TextBlock Text="{Binding RouteSummary}" Style="{StaticResource Strong}" MaxWidth="760"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Hops}" Focusable="False" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Ttl}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Address}" Style="{StaticResource Mono}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding MedianText}" Style="{StaticResource Strong}" HorizontalAlignment="Right" Foreground="{Binding Tone, Converter={StaticResource ToneToBrush}}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding LossText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Caption}" Margin="2,12,0,0"
                       Text="Что ещё снижает пинг: кабель вместо Wi-Fi, закрытые загрузки в фоне, «Оптимизация доставки» только в локальной сети (находка в анализе). Настройки вроде «TCP-твиков» Opti не предлагает: измеримого эффекта у них нет."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
