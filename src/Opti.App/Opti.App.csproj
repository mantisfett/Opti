<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Opti</AssemblyName>
    <RootNamespace>Opti.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\opti.ico</ApplicationIcon>
    <StartupObject>Opti.App.Program</StartupObject>
    <!-- Тема Fluent (Application.ThemeMode) в WPF пока помечена как экспериментальная -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- Портативный один файл: dotnet publish -c Release -r win-x64 -->
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- TraceEvent и WPF загружают нативные библиотеки по пути сборки — распаковываем всё содержимое -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Opti.ViewModels\Opti.ViewModels.csproj" />
    <ProjectReference Include="..\Opti.Bench\Opti.Bench.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="Assets\opti.ico" />
    <Resource Include="Assets\opti.png" />
    <Resource Include="Assets\opti-wordmark.png" />
  </ItemGroup>
</Project>
