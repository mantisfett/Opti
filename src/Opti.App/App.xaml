<Application x:Class="Opti.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Opti.App.Controls"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <!-- Шрифты Windows 11 с оптической настройкой под размер: Display — заголовки (≥ 18 px),
                 Text — основной текст, Small — подписи (≤ 12 px). На Windows 10 — Segoe UI. -->
            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
            <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="SmallFont">Segoe UI Variable Small, Segoe UI</FontFamily>
            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

            <!-- Фирменные цвета Opti (из логотипа): синий → бирюзовый, зелёная точка «готово».
                 Ключи Accent* переопределяют системный акцент темы Fluent, поэтому весь интерфейс в цветах бренда.
                 Цвет акцентного текста зависит от темы — его задаёт App.ApplyBrandTheme(). -->
            <Color x:Key="BrandBlue">#1565FF</Color>
            <Color x:Key="BrandCyan">#19E3F0</Color>
            <Color x:Key="BrandGreen">#2EE59D</Color>
            <Color x:Key="BrandNight">#050A18</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#1A72FF"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#3A88FF"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#155FD6"/>
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AccentSolidBrush" Color="#2563EB"/>
            <SolidColorBrush x:Key="AccentSolidHoverBrush" Color="#1D4ED8"/>
            <SolidColorBrush x:Key="BrandGreenBrush" Color="{StaticResource BrandGreen}"/>
            <!-- Мягкая акцентная подложка (плитки значков, плашки) — читается и в светлой, и в тёмной теме -->
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#241A72FF"/>
            <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,1" EndPoint="1,0">
                <GradientStop Color="#1565FF" Offset="0"/>
                <GradientStop Color="#16B4F6" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BrandGradientHoverBrush" StartPoint="0,1" EndPoint="1,0">
                <GradientStop Color="#2B77FF" Offset="0"/>
                <GradientStop Color="#2CC6FA" Offset="1"/>
            </LinearGradientBrush>
            <!-- Тёмная «баннерная» поверхность — одинаковая в светлой и тёмной теме -->
            <LinearGradientBrush x:Key="BrandHeroBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#050A18" Offset="0"/>
                <GradientStop Color="#081833" Offset="0.6"/>
                <GradientStop Color="#0A2A55" Offset="1"/>
            </LinearGradientBrush>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <c:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
            <c:StringToVisibilityConverter x:Key="StrToVis"/>
            <c:CountToVisibilityConverter x:Key="CountToVis"/>
            <c:ToneToBrushConverter x:Key="ToneToBrush"/>
            <c:ToneToSoftBrushConverter x:Key="ToneToSoft"/>

            <!-- ===== Токены: сетка 4/8 px, единые отступы страниц и карточек ===== -->
            <Thickness x:Key="PageMargin">40,28,40,40</Thickness>
            <Thickness x:Key="BarPadding">40,12,40,12</Thickness>
            <sys:Double x:Key="ContentMaxWidth">880</sys:Double>
            <CornerRadius x:Key="RadiusCard">8</CornerRadius>
            <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
            <CornerRadius x:Key="RadiusPill">10</CornerRadius>

            <!-- Видимая рамка фокуса для клавиатуры (Tab) на своих кнопках -->
            <Style x:Key="FocusRing">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border Margin="-3" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Рамка фокуса пункта навигации — повторяет форму подсветки пункта -->
            <Style x:Key="NavFocusRing">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border Margin="6,1" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Рамка фокуса крупной карточки -->
            <Style x:Key="CardFocusRing">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border Margin="-3,-3,9,-3" CornerRadius="14" BorderThickness="2" BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Типографика (шкала Fluent: 12 / 14 / 16 / 18 / 20 / 28) ===== -->
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="LineHeight" Value="36"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            </Style>
            <Style x:Key="Subtitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="LineHeight" Value="28"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="LineHeight" Value="24"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,32,0,12"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            </Style>
            <!-- Пояснение под заголовком раздела -->
            <Style x:Key="SectionLead" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="LineHeight" Value="20"/>
                <Setter Property="Margin" Value="0,-6,0,14"/>
                <Setter Property="MaxWidth" Value="720"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>
            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="LineHeight" Value="24"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            </Style>
            <Style x:Key="Strong" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="LineHeight" Value="20"/>
            </Style>
            <Style x:Key="Body" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="LineHeight" Value="20"/>
            </Style>
            <Style x:Key="Secondary" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="LineHeight" Value="20"/>
            </Style>
            <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                <Setter Property="FontFamily" Value="{StaticResource SmallFont}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="LineHeight" Value="16"/>
            </Style>
            <Style x:Key="Icon" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="Mono" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <!-- Квадратная плитка со значком (карточки, режимы) -->
            <Style x:Key="IconTile" TargetType="Border">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>
            <Style x:Key="IconTileGlyph" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
            </Style>

            <!-- Текст на тёмном фирменном баннере -->
            <Style x:Key="HeroTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
                <Setter Property="FontSize" Value="30"/>
                <Setter Property="LineHeight" Value="38"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#F4F8FF"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="HeroText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#C2CFE4"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="LineHeight" Value="22"/>
            </Style>
            <Style x:Key="HeroChip" TargetType="Border">
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Margin" Value="0,0,8,8"/>
                <Setter Property="Background" Value="#1AFFFFFF"/>
                <Setter Property="BorderBrush" Value="#26FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <!-- Поверхности -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
                <Setter Property="Padding" Value="16,14"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <Style x:Key="Divider" TargetType="Border">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
                <Setter Property="Margin" Value="0,12"/>
            </Style>
            <!-- Маленькая цветная точка статуса -->
            <Style x:Key="Dot" TargetType="Ellipse">
                <Setter Property="Width" Value="8"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
            </Style>

            <!-- Главная кнопка: системный акцентный цвет -->
            <Style x:Key="AccentButton" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                <Setter Property="Background" Value="{StaticResource AccentSolidBrush}"/>
                <Setter Property="Padding" Value="20,8"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSolidHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorDisabledBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorDisabledBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Ссылка -->
            <Style x:Key="LinkButton" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <TextBlock x:Name="T" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="T" Property="TextDecorations" Value="Underline"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Пункт навигации: подсветка и «пилюля» акцентного цвета у выбранного -->
            <Style x:Key="NavButton" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{StaticResource NavFocusRing}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,9" Margin="6,1">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Выбор одного варианта карточками (цель, режим замера) -->
            <Style x:Key="ChoiceList" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusCard}" Padding="14,12" Margin="0,0,8,8">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                                <Setter TargetName="Bd" Property="Padding" Value="13,11"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Компоненты ===== -->

            <!-- Плашка (тег): фон — тон с прозрачностью, текст — тон. Пример: важность находки, статус драйвера -->
            <Style x:Key="Tag" TargetType="Border">
                <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="TagText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource SmallFont}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <!-- Подсказка/предупреждение внутри страницы -->
            <Style x:Key="Callout" TargetType="Border">
                <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
                <Setter Property="Padding" Value="14,12"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <!-- Плитка с цифрой (сводка) -->
            <Style x:Key="StatValue" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="StatTile" TargetType="ToggleButton">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="14,10" Margin="0,0,8,0">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                    <Setter TargetName="Bd" Property="Padding" Value="13,9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Переключатель (вкл/выкл) для твиков — на базе CheckBox, доступен с клавиатуры (Пробел) -->
            <Style x:Key="ToggleSwitch" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Grid Width="40" Height="20">
                                    <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                                            Background="{DynamicResource ControlAltFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"/>
                                    <Ellipse x:Name="Thumb" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0,0,0"
                                             Fill="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Ellipse.RenderTransform><TranslateTransform x:Name="Shift" X="0"/></Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{StaticResource BrandGradientBrush}"/>
                                    <Setter TargetName="Track" Property="BorderThickness" Value="0"/>
                                    <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard><DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.12"/></Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard><DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.12"/></Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Плитка-кнопка (инструменты на главной): карточка, которая целиком нажимается -->
            <Style x:Key="ToolTile" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="{StaticResource RadiusLarge}" Padding="16,14">
                                <ContentPresenter HorizontalAlignment="Left"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Нижняя панель действий страницы: главное действие всегда на виду -->
            <Style x:Key="ActionBar" TargetType="Border">
                <Setter Property="Padding" Value="{StaticResource BarPadding}"/>
                <Setter Property="BorderThickness" Value="0,1,0,0"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="Background" Value="{DynamicResource LayerFillColorAltBrush}"/>
            </Style>

            <!-- Заголовок группы в навигации -->
            <Style x:Key="NavHeader" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                <Setter Property="Margin" Value="24,18,0,6"/>
            </Style>

            <!-- ===== Карточки режимов на главной: выбор одного из трёх, «радио» в углу ===== -->
            <Style x:Key="ModeCardList" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,-12,0"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FocusVisualStyle" Value="{StaticResource CardFocusRing}"/>
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusLarge}" Padding="18,16" Margin="0,0,12,0">
                                            <Grid>
                                                <ContentPresenter/>
                                                <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Width="20" Height="20" Margin="0,2,0,0">
                                                    <Ellipse x:Name="Ring" Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="1.5"/>
                                                    <Ellipse x:Name="Fill" Fill="{StaticResource BrandGradientBrush}" Visibility="Collapsed"/>
                                                    <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>
                                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                                <Setter TargetName="Bd" Property="Padding" Value="17,15"/>
                                                <Setter TargetName="Ring" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Fill" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Сегментированный переключатель (режим на странице исправлений) -->
            <Style x:Key="Segmented" TargetType="ListBox">
                <Setter Property="Background" Value="{DynamicResource ControlAltFillColorSecondaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="3"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ItemsPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="14,6">
                                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandGradientBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Деление индикатора «глубина изменений» -->
            <Style x:Key="LevelBar" TargetType="Border">
                <Setter Property="Width" Value="22"/>
                <Setter Property="Height" Value="4"/>
                <Setter Property="CornerRadius" Value="2"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource ControlStrongStrokeColorDisabledBrush}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
